# Environment support
CONFIG_ENV_SUPPORT=y
CONFIG_ENV=y
CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_SIZE=0x2000
CONFIG_ENV_OFFSET=0
CONFIG_ENV_OFFSET_REDUND=0

# Environment commands
CONFIG_CMD_ENV=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_EDITENV=y
CONFIG_CMD_EXPORTENV=y
CONFIG_CMD_IMPORTENV=y

# Environment flags and callbacks
CONFIG_REGEX=y
CONFIG_ENV_FLAGS_LIST_DEFAULT=y
CONFIG_ENV_CALLBACK_LIST_DEFAULT=y
CONFIG_ENV_OVERWRITE=y
CONFIG_USE_DEFAULT_ENV_FILE=y

# Network and DHCP
CONFIG_CMD_DHCP_CLIENT_ID=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_NFS=y
CONFIG_CMD_PING=y
CONFIG_NET=y
CONFIG_IP_DEFRAG=y
CONFIG_PROT_TCP=y

# SPI Flash
CONFIG_DM_SPI=y
CONFIG_DM_SPI_FLASH=y
CONFIG_SPI_FLASH=y
CONFIG_SPI_FLASH_BAR=y
CONFIG_SPI=y
CONFIG_CMD_SF=y
CONFIG_CMD_SPI=y

# Additional required configs
CONFIG_LIB_UUID=y
CONFIG_PARTITION_UUIDS=y
CONFIG_CMD_PART=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
